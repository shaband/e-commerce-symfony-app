<form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">

    <button class="inline-flex items-center gap-2 rounded-lg bg-error-500 px-5 py-3.5 text-sm font-medium text-white shadow-theme-xs transition " type="submit">
        Delete
    </button>
</form>
