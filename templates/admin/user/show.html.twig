                                <p class="font-medium text-gray-500 text-theme-xs dark:text-gray-400">
                                    Phone
                                </p>
                            </div> <td class="px-5 py-3 sm:px-6">
                            <div class="flex items-center">
                                <p class="font-medium text-gray-500 text-theme-xs dark:text-gray-400">
                                    {{ user.phone  }}
                                </p>
                            </div>
                        </td>
                    <tr>

                    <tr class="border-b border-r border-gray-100 dark:border-gray-800">
                        <td class="px-5 py-3 sm:px-6">
                            <div class="flex items-center">
                                <p class="font-medium text-gray-500 text-theme-xs dark:text-gray-400">
                                    Avatar
                                </p>
                            </div> <td class="px-5 py-3 sm:px-6">
                            <div class="flex items-center">

<img src="{{ asset(user.avatar??'admin/src/images/user/owner.jpg') }}" width="100" alt="{{ user.fullName }}"/>

                            </div>
                        </td>
                    <tr>

                    <tr class="border-b border-r border-gray-100 dark:border-gray-800">
                        <td class="px-5 py-3 sm:px-6">
                            <div class="flex items-center">
                                <p class="font-medium text-gray-500 text-theme-xs dark:text-gray-400">
                                    Birthdate
                                </p>
                            </div> <td class="px-5 py-3 sm:px-6">
                            <div class="flex items-center">
                                <p class="font-medium text-gray-500 text-theme-xs dark:text-gray-400">
                                    {{ user.birthdate ? user.birthdate|date('Y-m-d') : '' }}
                                </p>
                            </div>
                        </td>
                    <tr>
                    <tr class="border-b border-r border-gray-100 dark:border-gray-800">
                        <td class="px-5 py-3 sm:px-6">
                            <div class="flex items-center">
                                <p class="font-medium text-gray-500 text-theme-xs dark:text-gray-400">
                                    Actions
                                </p>
                            </div>
                        <td class="px-5 py-3 sm:px-6">
                            <div class="flex items-center">

                                <div class="border-t border-gray-100 px-6 py-6.5 dark:border-gray-800">
                                    <div class="flex items-center gap-5">
                                        <a class="inline-flex items-center gap-2 px-4 py-3 text-sm font-medium text-white transition rounded-lg bg-brand-500 shadow-theme-xs hover:bg-brand-600"
                                           href="{{ path('admin_user_index') }}"
                                        >
                                            Back
                                        </a>

                                        {{ include('admin/user/_delete_form.html.twig') }}

                                    </div>
                                </div>
                            </div>

                        </td>
                    <tr>

                    </tbody>
                </table>

{#                <a href="{{ path('admin_user_index') }}">back to list</a>#}

{#                <a href="{{ path('admin_user_edit', {'id': user.id}) }}">edit</a>#}

{#                {{ include('admin/user/_delete_form.html.twig') }}#}
            </div>
        </div>
    </div>
{% endblock %}
