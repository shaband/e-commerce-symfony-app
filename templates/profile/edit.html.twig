{% extends 'site/layout/base.html.twig' %}
{% block title %}
    Profile
{% endblock %}

{% block content %}
    <!--====== App Content ======-->
    <div class="app-content">

        <!--====== Section 1 ======-->
        <div class="u-s-p-y-60">

            <!--====== Section Content ======-->
            <div class="section__content">
                <div class="container">
                    <div class="breadcrumb">
                        <div class="breadcrumb__wrap">
                            <ul class="breadcrumb__list">
                                <li class="has-separator">

                                    <a href="{{ path('app_index') }}">Home</a></li>
                                <li class="is-marked">

                                    <a href="{{ path('app_profile') }}">My Account</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--====== End - Section 1 ======-->


        <!--====== Section 2 ======-->
        <div class="u-s-p-b-60">

            <!--====== Section Content ======-->
            <div class="section__content">
                <div class="dash">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-3 col-md-12">

                                <!--====== Dashboard Features ======-->
                                {% include 'profile/_sidebar.html.twig' %}
                                <!--====== End - Dashboard Features ======-->
                            </div>
                            <div class="col-lg-9 col-md-12">
                                <div class="dash__box dash__box--shadow dash__box--radius dash__box--bg-white">
                                    <div class="dash__pad-2">
                                        <h1 class="dash__h1 u-s-m-b-14">Edit Profile</h1>

                                        <span
                                            class="dash__text u-s-m-b-30">Looks like you haven't update your profile</span>

                                        <div class="row">
                                            <div class="col-lg-12">
                                                {{ form_start(form,{
                                                    method:'PUT',
                                                    attr:{class:'dash-edit-p'}
                                                }) }}
                                                <div class="gl-inline">
                                                    <div class="u-s-m-b-30">

                                                        {{ form_row(form.first_name,{
                                                            label:'FIRST NAME *',
                                                            label_attr:{
                                                                class:'gl-label'
                                                            },
                                                            attr:{class:'input-text input-text--primary-style'}
                                                        }) }}
                                                    </div>
                                                    <div class="u-s-m-b-30">


                                                        {{ form_row(form.last_name,{
                                                            label:'LAST NAME *',
                                                            label_attr:{
                                                                class:'gl-label',
                                                            },
                                                            attr:{class:'input-text input-text--primary-style'}
                                                        }) }}
                                                    </div>
                                                </div>
                                                <div class="gl-inline">
                                                    <div class="u-s-m-b-30">

                                                        <!--====== Date of Birth Select-Box ======-->

                                                        {{ form_row(form.birthdate,{
                                                            label:'BIRTHDAY',
                                                            label_attr:{
                                                                class:'gl-label'
                                                            },
                                                            attr:{class:'input-text input-text--primary-style'}
                                                        }) }}

                                                        <!--====== End - Date of Birth Select-Box ======-->
                                                    </div>
                                                    <div class="u-s-m-b-30">
                                                        {{ form_row(form.gender,{
                                                            label:'GENDER',
                                                            label_attr:{
                                                                class:'gl-label'
                                                            },
                                                            attr:{class:'input-text input-text--primary-style'}
                                                        }) }}
                                                    </div>
                                                </div>
                                                <div class="gl-inline">
                                                    <div class="u-s-m-b-30">
                                                        {{ form_row(form.email,{
                                                            label:'EMAIL *',
                                                            label_attr:{
                                                                class:'gl-label'
                                                            },
                                                            attr:{class:'input-text input-text--primary-style'}
                                                        }) }}
                                                    </div>
                                                    <div class="u-s-m-b-30">
                                                        {{ form_row(form.phone,{
                                                            label:'PHONE',
                                                            label_attr:{
                                                                class:'gl-label'
                                                            },
                                                            attr:{class:'input-text input-text--primary-style'}
                                                        }) }}
                                                    </div>
                                                </div>

                                                <button class="btn btn--e-brand-b-2" type="submit">SAVE</button>

                                                {{ form_rest(form) }}
                                                {{ form_end(form) }}

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!--====== End - Section Content ======-->
        </div>
        <!--====== End - Section 2 ======-->
    </div>
    <!--====== End - App Content ======-->
{% endblock %}
